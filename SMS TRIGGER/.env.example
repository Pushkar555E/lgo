# --- Database (from your RiskZones/SensorTelemetry PostGIS schema) ---
DATABASE_URL=postgresql://user:password@localhost:5432/landslide_monitoring

# --- Python AI risk-score service (from the FastAPI microservice) ---
AI_SERVICE_URL=http://localhost:8001

# --- Twilio SMS alerting (optional) ---
# Leave these unset to run in mock mode — the script logs what it WOULD
# send instead of actually sending, so the demo never breaks on a missing
# Twilio account. Fill them in for a real SMS to fire during the pitch.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_PHONE_NUMBER=

# --- Demo tuning ---
# Set to "true" to run the whole escalation with no DB/AI/SMS calls at all —
# just prints the sequence. Useful for rehearsing timing beforehand.
DRY_RUN=false

# Milliseconds between each escalation step during the live demo
STEP_DELAY_MS=2500
